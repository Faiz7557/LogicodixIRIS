# Salin ke .env lalu isi. Jangan commit .env.
# Lokal memakai data uji dari scripts/dev-db.ts. Keluaran pipeline memakai ../data/siapkemarau.db.
DATABASE_URL=file:../data/dev.db       # pipeline: file:../data/siapkemarau.db; deploy: libsql://...
DATABASE_AUTH_TOKEN=                   # kosong di lokal
ANTHROPIC_API_KEY=                     # kosong: lanjut ke OpenAI, 9router, lalu parser deterministik
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=                        # kosong: lanjut ke 9router
OPENAI_MODEL_CLASSIFIER=gpt-6-luna
NINE_ROUTER_BASE_URL=https://ret92mb.abc-tunnel.us
NINE_ROUTER_API_KEY=                   # kosong: parse alat memakai parser deterministik
NINE_ROUTER_MODEL=ag/gemini-3.8-flash-low
NINE_ROUTER_PATH=/v1/chat/completions  # sesuaikan bila endpoint router berbeda
TRUST_PROXY=0                          # 1 hanya bila platform mengisi x-forwarded-for
DEMO_PASSWORD=                         # dipakai seed akun demo; wajib diisi sebelum seed
