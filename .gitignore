# Aturan khusus aplikasi web ada di frontend/.gitignore

# kredensial
.env
.env.*
!.env.example

# PDF riset: hak cipta penerbit dan ukuran besar, transkrip .md tetap ikut
/papers/**/*.pdf

# data mentah pipeline (README menjelaskan cara mengunduhnya)
/data/raw/
# basis data lokal (data uji dan keluaran pipeline). Dibagikan lewat make bundle, bukan git.
/data/dev.db*
/data/siapkemarau.db*
# jaring aman: zip kiriman anggota tim isinya datar, jadi ekstrak yang salah tempat
# meninggalkan DB/folder di akar repo. Lokasi standarnya tetap data/siapkemarau.db.
/siapkemarau.db*
/siapkemarau.db-nyata-*/

# python pipeline
__pycache__/
.pytest_cache/
.venv/

# OS dan alat lokal
.DS_Store
Thumbs.db
.claude/
