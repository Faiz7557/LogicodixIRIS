# Aturan khusus aplikasi web ada di frontend/.gitignore

# kredensial
.env
.env.*
!.env.example

# PDF riset: hak cipta penerbit dan ukuran besar, transkrip .md tetap ikut
/papers/**/*.pdf

# data mentah pipeline (README menjelaskan cara mengunduhnya)
/data/raw/
# basis data lokal. data/siapkemarau.db (DB nyata hasil pipeline) ikut git;
# data uji, cadangan, journal, dan paket zip tidak.
/data/dev.db*
/data/siapkemarau.db?*
/data/*.zip
/data/siapkemarau-data/

# python pipeline
__pycache__/
.pytest_cache/
.venv/

# OS dan alat lokal
.DS_Store
Thumbs.db
.claude/
